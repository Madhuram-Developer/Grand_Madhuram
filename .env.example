# MongoDB (Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/madhuram
# 32+ random chars: openssl rand -base64 36
AUTH_SECRET=
# Public origin, used for canonical/hreflang/sitemap/WhatsApp links
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Cloudinary (required for admin uploads): cloudinary://<api_key>:<api_secret>@<cloud_name>  (server only, signs uploads)
CLOUDINARY_URL=
# Base URL every stored media path is appended to. DB stores only "madhuram/abc123.jpg".
NEXT_PUBLIC_MEDIA_URL=https://res.cloudinary.com/<cloud_name>/image/upload

# Google Search Console (admin analytics). Service account JSON → email + private_key; add the email as a user on the property.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# "sc-domain:example.com" (domain property) or "https://www.example.com/" (URL-prefix property)
GSC_SITE_URL=
